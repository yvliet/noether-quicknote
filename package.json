{
  "name": "quicknote",
  "version": "1.1.0",
  "description": "Instant floating scratchpad for capturing thoughts, web snippets, and ideas without leaving your current note.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "noether",
    "noether-extension",
    "quicknote",
    "scratchpad",
    "modal",
    "capture"
  ],
  "author": "Yuliet Li <recrified@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yvliet/quicknote.git"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "noether": "^0.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  }
}
